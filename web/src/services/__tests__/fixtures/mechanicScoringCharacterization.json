{
  "description": "Frozen M feature-id outputs captured from the pre-witness TypeScript scoring extractor.",
  "catalog": {
    "default_skill": {
      "甲": "甲自带提供",
      "乙": "乙自带受益",
      "丙": "丙自带闭环",
      "丁": "丁自带中性",
      "戊": "戊自带中性"
    },
    "mechanic_names": {
      "buff:guard": "守备",
      "buff:shield": "护盾",
      "debuff:fire": "火攻"
    },
    "skills": {
      "甲自带提供": [
        { "relation": "provides", "mechanic": "debuff:fire", "subject": "enemy" }
      ],
      "乙自带受益": [
        { "relation": "benefits_from", "mechanic": "debuff:fire", "subject": "enemy" }
      ],
      "丙自带闭环": [
        { "relation": "provides", "mechanic": "buff:guard", "subject": "team" },
        { "relation": "requires", "mechanic": "buff:guard", "subject": "team" }
      ],
      "援护提供": [
        { "relation": "provides", "mechanic": "buff:shield", "subject": "ally" }
      ],
      "自身需要": [
        { "relation": "requires", "mechanic": "buff:shield", "subject": "self" }
      ],
      "烈火提供": [
        { "relation": "provides", "mechanic": "debuff:fire", "subject": "enemy" }
      ]
    }
  },
  "cases": [
    {
      "name": "default_provider_to_default_consumer",
      "team": [
        { "name": "甲", "equipped": [] },
        { "name": "乙", "equipped": [] },
        { "name": "丙", "equipped": [] }
      ],
      "expected_m": ["M|debuff:fire|benefits_from|enemy"]
    },
    {
      "name": "same_instance_default_self_loop_is_rejected",
      "team": [
        { "name": "丙", "equipped": [] },
        { "name": "丁", "equipped": [] },
        { "name": "戊", "equipped": [] }
      ],
      "expected_m": []
    },
    {
      "name": "canonical_and_equipped_copy_are_distinct_instances",
      "team": [
        { "name": "丙", "equipped": ["丙自带闭环"] },
        { "name": "甲", "equipped": [] },
        { "name": "乙", "equipped": [] }
      ],
      "expected_m": [
        "M|buff:guard|requires|friendly",
        "M|debuff:fire|benefits_from|enemy"
      ]
    },
    {
      "name": "ally_provider_only_reaches_different_carrier_self_consumer",
      "team": [
        { "name": "甲", "equipped": ["援护提供"] },
        { "name": "乙", "equipped": ["自身需要"] },
        { "name": "丙", "equipped": [] }
      ],
      "expected_m": [
        "M|buff:shield|requires|friendly",
        "M|debuff:fire|benefits_from|enemy"
      ]
    },
    {
      "name": "same_carrier_ally_provider_does_not_reach_self_consumer",
      "team": [
        { "name": "甲", "equipped": ["援护提供", "自身需要"] },
        { "name": "乙", "equipped": [] },
        { "name": "丙", "equipped": [] }
      ],
      "expected_m": ["M|debuff:fire|benefits_from|enemy"]
    },
    {
      "name": "repeated_providers_presence_encode_one_m_id",
      "team": [
        { "name": "甲", "equipped": ["烈火提供", "烈火提供"] },
        { "name": "乙", "equipped": [] },
        { "name": "丙", "equipped": [] }
      ],
      "expected_m": ["M|debuff:fire|benefits_from|enemy"]
    }
  ]
}
